# ===================================================
# Gym Track - Environment Variables Template
# ===================================================
# Renomeie este arquivo para .env e preencha as variáveis abaixo:

# Supabase Credentials (Obrigatório)
# Encontradas em: Project Settings -> API no painel do Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-key-aqui

# Configurações do Projeto (Opcional)
VUE_APP_PROJECT_NAME=Gym Track
VUE_APP_THEME_COLOR_PRIMARY=#4CAF50
VUE_APP_THEME_COLOR_SECONDARY=#FAFAFA
VUE_APP_THEME_COLOR_ACCENT=#FF9800

VUE_APP_I18N_LOCALE=pt
VUE_APP_I18N_FALLBACK_LOCALE=en
